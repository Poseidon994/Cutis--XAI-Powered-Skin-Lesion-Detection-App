# ---- required ---------------------------------------------------------------------------------------------
# At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=
# Shared secret between the API server and the ML service:  openssl rand -hex 16
ML_SERVICE_KEY=
# Clinician accounts need this code at sign-up. In production, clinician sign-up is disabled while it is empty.
CLINICIAN_INVITE_CODE=cutis

# ---- MySQL database ---------------------------------------------------------------------------------------
# Docker compose creates the database and user itself (MYSQL_* below). Without Docker, create them first:
#   CREATE DATABASE cutis CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'cutis'@'%' IDENTIFIED BY '...'; GRANT ALL PRIVILEGES ON cutis.* TO 'cutis'@'%';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Connection pool size for the API server (optional).
DB_POOL=10
# Used only by docker compose to provision the MySQL container:
MYSQL_ROOT_PASSWORD=Om@090904
MYSQL_DATABASE=cutis
MYSQL_USER=cutis
MYSQL_PASSWORD=cutis090904
# ---- AI agent (Groq) --------------------------------------------------------------------------------------
# Without a key the app still works: explanations and reports use fixed template text and the chat is disabled.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# ---- guideline library (RAG) ------------------------------------------------------------------------------
# 0 switches the library off everywhere: reports then say they are not checked against guidelines.
RAG_ENABLED=1
# auto tries fastembed, then sentence-transformers; none = keyword search only.
RAG_EMBEDDER=auto
# Relevance floor for the meaning search; scripts/rag_eval.py suggests a value for your library.
RAG_MIN_COSINE=0.55
RAG_MIN_TERMS=3
# Passages sent to the model per report; more costs tokens and rate limit.
RAG_MAX_PASSAGES=6
# No single document may fill the answer.
RAG_MAX_PER_SOURCE=2
# Where the library lives (the ml service reads it; rag_fetch/rag_build write it).
RAG_DIR=./rag
# Server-side: how long the API waits for one retrieval before giving up (ms).
RAG_TIMEOUT_MS=8000

# ---- deployment -------------------------------------------------------------------------------------------
WEB_PORT=8080
# 0 while you browse over plain http://localhost, 1 as soon as the site is served over https.
COOKIE_SECURE=0
# Folder holding the training notebook's artifacts/ output (meta.json, isic_v4_lib.py, backbones/, oof_predictions.csv.gz ...).
ARTIFACTS_PATH=./artifacts
# PyTorch wheel index for the ML image: CPU (default) or a CUDA build for docker-compose.gpu.yml.
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# ---- ML service tuning (all optional) ---------------------------------------------------------------------
ML_DEVICE=auto
# Load only the first N fold networks per backbone (0 = all that were trained). Cuts RAM and time roughly in proportion.
ML_MAX_FOLDS=0
# Test-time-augmentation views per network (0 = same as training).
ML_TTA_VIEWS=0
# Fold networks per backbone used by the explanation methods.
XAI_FOLDS=1
# 0 = automatic (CPU: LIME 150 / SHAP 24, GPU: LIME 500 / SHAP 64).
XAI_LIME_SAMPLES=0
XAI_SHAP_SAMPLES=0
# gradcam (Score-CAM is used automatically when gradients vanish) or scorecam.
XAI_CAM_METHOD=gradcam
