# ---- required ---------------------------------------------------------------------------------------------
# At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=
# Shared secret between the API server and the ML service:  openssl rand -hex 16
ML_SERVICE_KEY=
# Clinician accounts need this code at sign-up. In production, clinician sign-up is disabled while it is empty.
CLINICIAN_INVITE_CODE=

# ---- AI agent (Groq) --------------------------------------------------------------------------------------
# Without a key the app still works: explanations and reports use fixed template text and the chat is disabled.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated models tried in order if the main one is retired or unavailable.
GROQ_FALLBACK_MODELS=

# ---- deployment -------------------------------------------------------------------------------------------
WEB_PORT=8080
# 0 while you browse over plain http://localhost, 1 as soon as the site is served over https.
COOKIE_SECURE=0
# Folder holding the training notebook's artifacts/ output (meta.json, isic_v4_lib.py, backbones/, oof_predictions.csv.gz ...).
ARTIFACTS_PATH=./artifacts
# PyTorch wheel index for the ML image: CPU (default) or a CUDA build for docker-compose.gpu.yml.
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# ---- ML service tuning (all optional) ---------------------------------------------------------------------
ML_DEVICE=auto
# Load only the first N fold networks per backbone (0 = all that were trained). Cuts RAM and time roughly in proportion.
ML_MAX_FOLDS=0
# Test-time-augmentation views per network (0 = same as training).
ML_TTA_VIEWS=0
# Fold networks per backbone used by the explanation methods.
XAI_FOLDS=1
# 0 = automatic (CPU: LIME 150 / SHAP 24, GPU: LIME 500 / SHAP 64).
XAI_LIME_SAMPLES=0
XAI_SHAP_SAMPLES=0
# gradcam (Score-CAM is used automatically when gradients vanish) or scorecam.
XAI_CAM_METHOD=gradcam
